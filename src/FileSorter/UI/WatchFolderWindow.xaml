<Window x:Class="FileSorter.UI.WatchFolderWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FileSorter - 自动归类"
        Width="1020" Height="700"
        WindowStartupLocation="CenterScreen"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStyle="None"
        ResizeMode="CanResize"
        FontFamily="Microsoft YaHei UI, Microsoft YaHei, Segoe UI"
        UseLayoutRounding="True">

    <!--
      ⚠️ 不要用 <Window.InputBindings><MouseBinding MouseButton="Left" .../></Window.InputBindings>
      做标题栏拖动:XAML 里写 MouseButton.Left 会报 MC3072(属性名解析不到,
      因为 XAML 的默认命名空间里没有 MouseButton 类型),加 xmlns:sys 前缀也一样报错。
      正确做法见 WatchFolderWindow.xaml.cs 的 BindTitleBarDrag() —— 直接挂
      TitleBar 的 MouseLeftButtonDown,还能精确避开「点按钮不触发拖动」。
    -->
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/FileSorter;component/UI/Theme.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid x:Name="RootGrid">
        <!-- 玻璃底盘 -->
        <Border x:Name="Chrome"
                Background="{StaticResource GlassChromeBrush}"
                BorderBrush="{StaticResource GlassBorderBrush}"
                BorderThickness="1"
                CornerRadius="10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="40" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- ===== 标题栏 ===== -->
                <Border Grid.Row="0"
                        Background="{StaticResource GlassTitleBarBrush}"
                        BorderBrush="{StaticResource GlassDividerBrush}"
                        BorderThickness="0,0,0,1"
                        CornerRadius="10,10,0,0"
                        x:Name="TitleBar">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
                                   Text="FileSorter · 自动归类"
                                   FontSize="13.5"
                                   FontWeight="Medium"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   VerticalAlignment="Center"
                                   Margin="16,0,0,0" />

                        <StackPanel Grid.Column="1" Orientation="Horizontal"
                                    VerticalAlignment="Center" Margin="0,0,6,0">
                            <Button Content="—" Style="{StaticResource RowButton}"
                                    Width="42" Height="30" BorderThickness="0"
                                    Background="Transparent" Click="OnMinimize"
                                    ToolTip="最小化" />
                            <Button Content="☐" Style="{StaticResource RowButton}"
                                    Width="42" Height="30" BorderThickness="0"
                                    Background="Transparent" Click="OnMaximize"
                                    ToolTip="最大化 / 还原" />
                            <Button Content="✕" Style="{StaticResource RowButton}"
                                    Width="42" Height="30" BorderThickness="0"
                                    Background="Transparent" Click="OnClose"
                                    ToolTip="关闭" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- ===== 主体:左状态栏 + 右内容 ===== -->
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="236" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- 左侧:实时状态 -->
                    <Border Grid.Column="0"
                            Background="#14FFFFFF"
                            BorderBrush="{StaticResource GlassDividerBrush}"
                            BorderThickness="0,0,1,0">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="14,16,14,16" x:Name="SidePanel" />
                        </ScrollViewer>
                    </Border>

                    <!-- 右侧:内容 -->
                    <Grid Grid.Column="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Margin="24,18,24,14" x:Name="HeadPanel" />

                        <ScrollViewer Grid.Row="1"
                                      VerticalScrollBarVisibility="Auto"
                                      Margin="24,0,16,12">
                            <StackPanel x:Name="ContentPanel" />
                        </ScrollViewer>
                    </Grid>
                </Grid>
            </Grid>
        </Border>

        <!-- 模态遮罩(添加/编辑对话框用) -->
        <Border x:Name="Overlay"
                Background="#99000000"
                Visibility="Collapsed"
                MouseLeftButtonUp="OnOverlayClick" />
    </Grid>
</Window>

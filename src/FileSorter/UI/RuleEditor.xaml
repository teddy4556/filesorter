<Window x:Class="FileSorter.UI.RuleEditor"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FileSorter - 规则编辑器" Width="1020" Height="700"
        WindowStartupLocation="CenterScreen"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStyle="None"
        ResizeMode="CanResize"
        FontFamily="Microsoft YaHei UI, Microsoft YaHei, Segoe UI"
        UseLayoutRounding="True">

    <!--
      2026-10-20 重写为旧毛玻璃风格,与「自动归类」窗口(WatchFolderWindow)保持一致。
      原来这窗口还是老式系统窗口 + 硬编码配色(#FF9800 / #4CAF50 / #F5F5F5),
      跟另一个窗口放在一起像两个应用。

      ⚠️ 标题栏拖动不要用 <Window.InputBindings><MouseBinding MouseButton="Left"/>
      —— 那样写 XAML 编译器报 MC3072。正确做法见 RuleEditor.xaml.cs 的 BindTitleBarDrag()。
    -->
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/FileSorter;component/UI/Theme.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid x:Name="RootGrid">
        <Border x:Name="Chrome"
                Background="{StaticResource GlassChromeBrush}"
                BorderBrush="{StaticResource GlassBorderBrush}"
                BorderThickness="1"
                CornerRadius="10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="40" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- ===== 标题栏 ===== -->
                <Border Grid.Row="0"
                        Background="{StaticResource GlassTitleBarBrush}"
                        BorderBrush="{StaticResource GlassDividerBrush}"
                        BorderThickness="0,0,0,1"
                        CornerRadius="10,10,0,0"
                        x:Name="TitleBar">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
                                   Text="FileSorter · 规则编辑器"
                                   FontSize="13.5"
                                   FontWeight="Medium"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   VerticalAlignment="Center"
                                   Margin="16,0,0,0" />

                        <StackPanel Grid.Column="1" Orientation="Horizontal"
                                    VerticalAlignment="Center" Margin="0,0,6,0">
                            <Button Content="—" Style="{StaticResource RowButton}"
                                    Width="42" Height="30" BorderThickness="0"
                                    Background="Transparent" Click="OnMinimize"
                                    ToolTip="最小化" />
                            <Button Content="☐" Style="{StaticResource RowButton}"
                                    Width="42" Height="30" BorderThickness="0"
                                    Background="Transparent" Click="OnMaximize"
                                    ToolTip="最大化 / 还原" />
                            <Button Content="✕" Style="{StaticResource RowButton}"
                                    Width="42" Height="30" BorderThickness="0"
                                    Background="Transparent" Click="OnClose"
                                    ToolTip="关闭" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- ===== 主体:工具条 + 左规则列表 + 右编辑面板 ===== -->
                <Grid Grid.Row="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- 工具条 -->
                    <Border Grid.Row="0"
                            Background="#10FFFFFF"
                            BorderBrush="{StaticResource GlassDividerBrush}"
                            BorderThickness="0,0,0,1"
                            Padding="16,10">
                        <StackPanel Orientation="Horizontal">
                            <Button Content="+ 添加" Click="OnAdd" Style="{StaticResource BaseButton}" Margin="0,0,6,0" />
                            <Button Content="删除" Click="OnDelete" Style="{StaticResource BaseButton}" Margin="0,0,6,0" />
                            <Button Content="上移" Click="OnMoveUp" Style="{StaticResource BaseButton}" Margin="0,0,6,0" />
                            <Button Content="下移" Click="OnMoveDown" Style="{StaticResource BaseButton}" Margin="0,0,10,0" />

                            <Rectangle Width="1" Fill="{StaticResource GlassDividerBrush}" Margin="0,4,10,4" />

                            <Button Content="加载示例…" Click="OnLoadExample" Style="{StaticResource BaseButton}" Margin="0,0,10,0" />

                            <Rectangle Width="1" Fill="{StaticResource GlassDividerBrush}" Margin="0,4,10,4" />

                            <Button Content="重新加载" Click="OnReload" Style="{StaticResource BaseButton}" Margin="0,0,6,0" />
                            <Button Content="保存" Click="OnSave" Style="{StaticResource PrimaryButton}" />
                        </StackPanel>
                    </Border>

                    <!-- 左规则列表 + 右编辑面板 -->
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="280" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0"
                                Background="#14FFFFFF"
                                BorderBrush="{StaticResource GlassDividerBrush}"
                                BorderThickness="0,0,1,0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Text="规则列表"
                                           FontSize="11" FontWeight="Bold"
                                           Foreground="{StaticResource TextTertiaryBrush}"
                                           Margin="14,14,10,8" />

                                <ListBox x:Name="RulesListBox" Grid.Row="1"
                                         SelectionChanged="OnSelectionChanged"
                                         Background="Transparent" BorderThickness="0"
                                         Margin="6,0,6,10">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <CheckBox IsChecked="{Binding Active}" Click="OnActiveToggle" VerticalAlignment="Center" />
                                                <TextBlock Text="{Binding Name}" Margin="6,0,0,0" VerticalAlignment="Center"
                                                           Foreground="{StaticResource TextPrimaryBrush}" />
                                                <TextBlock Text=" (" Foreground="{StaticResource TextTertiaryBrush}" />
                                                <TextBlock Text="{Binding Type}" Foreground="{StaticResource TextTertiaryBrush}" />
                                                <TextBlock Text=")" Foreground="{StaticResource TextTertiaryBrush}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Grid>
                        </Border>

                        <!-- 右侧:编辑面板 -->
                        <Grid Grid.Column="1">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" Margin="18,14,12,0">
                                <StackPanel x:Name="EditPanel">
                                    <TextBlock Text="选择左侧规则进行编辑"
                                               Foreground="{StaticResource TextTertiaryBrush}" />
                                </StackPanel>
                            </ScrollViewer>

                            <!-- 测试输入预览 -->
                            <Border Grid.Row="1"
                                    Background="{StaticResource CardBrush}"
                                    BorderBrush="{StaticResource GlassBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="14"
                                    Margin="18,10,18,14">
                                <StackPanel>
                                    <DockPanel LastChildFill="True">
                                        <TextBlock Text="测试输入:" VerticalAlignment="Center"
                                                   DockPanel.Dock="Left" Margin="0,0,4,0"
                                                   FontWeight="SemiBold" FontSize="12"
                                                   Foreground="{StaticResource TextSecondaryBrush}" />
                                        <TextBlock Text="(纯文件名或完整路径)" VerticalAlignment="Center"
                                                   DockPanel.Dock="Right"
                                                   Foreground="{StaticResource TextTertiaryBrush}" FontSize="11" />
                                    </DockPanel>
                                    <TextBox x:Name="PreviewInputBox"
                                             Text="filename.jpg"
                                             Style="{StaticResource GlassTextBox}"
                                             Margin="0,6,0,6"
                                             TextChanged="OnPreviewInputChanged" />
                                    <TextBlock x:Name="PreviewResultBox"
                                               Text="→ 等待输入"
                                               FontFamily="Consolas"
                                               Foreground="{StaticResource InfoBrush}"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Grid>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>

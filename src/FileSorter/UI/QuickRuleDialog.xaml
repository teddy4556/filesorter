<Window x:Class="FileSorter.UI.QuickRuleDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FileSorter - 选择规则" Width="520" SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStyle="None"
        ResizeMode="NoResize"
        FontFamily="Microsoft YaHei UI, Microsoft YaHei, Segoe UI"
        UseLayoutRounding="True">

    <!-- 2026-10-20 改毛玻璃,与规则编辑器 / 自动归类窗口统一 -->
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/FileSorter;component/UI/Theme.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Border Background="{StaticResource GlassChromeBrush}"
            BorderBrush="{StaticResource GlassBorderBrush}"
            BorderThickness="1"
            CornerRadius="10">
        <StackPanel Margin="24,20,24,20">
            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="FileSorter · 选择规则"
                           FontSize="15" FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>

                <Button Grid.Column="1" Content="✕" Style="{StaticResource RowButton}"
                        Width="42" Height="30" BorderThickness="0"
                        Background="Transparent" Click="OnCancel"
                        VerticalAlignment="Top" ToolTip="关闭" />
            </Grid>

            <TextBlock x:Name="FileCountText" Margin="0,0,0,10" TextWrapping="Wrap"
                       Foreground="{StaticResource TextSecondaryBrush}" />

            <ListBox x:Name="RulesList" Height="240" SelectionMode="Single"
                     Background="Transparent" BorderThickness="0">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Display}" Padding="6" FontSize="12.5"
                                   Foreground="{StaticResource TextPrimaryBrush}" />
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <Rectangle Height="1" Fill="{StaticResource GlassDividerBrush}" Margin="0,14,0,12" />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="取消" Click="OnCancel" Width="88"
                        Style="{StaticResource BaseButton}" Margin="0,0,8,0"/>
                <Button Content="确定" Click="OnOk" IsDefault="True" Width="88"
                        Style="{StaticResource PrimaryButton}"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
